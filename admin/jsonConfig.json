{
    "i18n": true,
    "type": "tabs",
    "items": {
        "mainTab": {
            "type": "panel",
            "label": "connection",
            "items": {
                "_header": {
                    "type": "header",
                    "text": "connectionSettings",
                    "size": 2
                },
                "host": {
                    "type": "text",
                    "label": "host",
                    "help": "hostHelp",
                    "sm": 8,
                    "validator": "data.host !== ''",
                    "validatorErrorText": "hostRequired"
                },
                "port": {
                    "type": "number",
                    "label": "port",
                    "help": "portHelp",
                    "min": 1,
                    "max": 65535,
                    "sm": 4,
                    "default": 443
                },
                "apiKey": {
                    "type": "text",
                    "label": "apiKey",
                    "help": "apiKeyHelp",
                    "sm": 6,
                    "validator": "data.apiKey !== ''",
                    "validatorErrorText": "apiKeyRequired"
                },
                "apiSecret": {
                    "type": "password",
                    "label": "apiSecret",
                    "help": "apiSecretHelp",
                    "sm": 6,
                    "validator": "data.apiSecret !== ''",
                    "validatorErrorText": "apiSecretRequired",
                    "visible": true
                },
                "_divider1": {
                    "type": "divider"
                },
                "_headerAdvanced": {
                    "type": "header",
                    "text": "advancedSettings",
                    "size": 3
                },
                "pollInterval": {
                    "type": "number",
                    "label": "pollInterval",
                    "help": "pollIntervalHelp",
                    "min": 10,
                    "max": 3600,
                    "sm": 4,
                    "default": 30,
                    "unit": "s"
                },
                "requestTimeout": {
                    "type": "number",
                    "label": "requestTimeout",
                    "help": "requestTimeoutHelp",
                    "min": 5,
                    "max": 60,
                    "sm": 4,
                    "default": 10,
                    "unit": "s"
                },
                "sslVerify": {
                    "type": "checkbox",
                    "label": "sslVerify",
                    "help": "sslVerifyHelp",
                    "sm": 4,
                    "default": true
                }
            }
        }
    }
}
