{
    "name": "iobroker.opnsense",
    "version": "0.0.1",
    "description": "Monitor OPNsense firewall gateways, interfaces, traffic and services",
    "author": {
        "name": "Eistee"
    },
    "homepage": "https://github.com/Eistee82/ioBroker.opnsense",
    "license": "MIT",
    "keywords": [
        "ioBroker",
        "opnsense",
        "firewall",
        "network",
        "monitoring",
        "gateway"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/Eistee82/ioBroker.opnsense.git"
    },
    "engines": {
        "node": ">=20"
    },
    "type": "module",
    "main": "build/main.js",
    "files": [
        "admin/",
        "build/",
        "docs/",
        "io-package.json",
        "LICENSE"
    ],
    "dependencies": {
        "@iobroker/adapter-core": "^3.2.3"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@iobroker/adapter-dev": "^1.3.0",
        "@iobroker/testing": "^5.0.0",
        "@types/node": "^22.0.0",
        "@typescript-eslint/eslint-plugin": "^8.0.0",
        "@typescript-eslint/parser": "^8.0.0",
        "eslint": "^9.0.0",
        "prettier": "^3.0.0",
        "typescript": "~5.7.0",
        "typescript-eslint": "^8.58.0"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "watch": "tsc -p tsconfig.build.json --watch",
        "lint": "eslint \"src/**/*.ts\"",
        "lint:fix": "eslint \"src/**/*.ts\" --fix",
        "format": "prettier --write \"src/**/*.ts\"",
        "test": "node --test build/**/*.test.js",
        "translate": "translate-adapter",
        "release-patch": "release-script patch --yes",
        "release-minor": "release-script minor --yes",
        "release-major": "release-script major --yes"
    },
    "bugs": {
        "url": "https://github.com/Eistee82/ioBroker.opnsense/issues"
    },
    "readmeFilename": "README.md"
}
