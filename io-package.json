    "native": {
        "host": "",
        "port": 443,
        "apiKey": "",
        "apiSecret": "",
        "pollInterval": 30,
        "sslVerify": true,
        "requestTimeout": 10
    },
    "protectedNative": ["apiSecret"],
    "encryptedNative": ["apiSecret"],
    "objects": [],
    "instanceObjects": [
        {
            "_id": "info",
            "type": "channel",
            "common": {
                "name": "Information"
            },
            "native": {}
        },
        {
            "_id": "info.connection",
            "type": "state",
            "common": {
                "name": "Connected to OPNsense",
                "type": "boolean",
                "role": "indicator.connected",
                "read": true,
                "write": false,
                "def": false
            },
            "native": {}
        }
    ]
